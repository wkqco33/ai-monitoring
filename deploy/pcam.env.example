# pcam 환경 변수 예시
# systemd의 EnvironmentFile=/etc/default/pcam 에서 그대로 읽히므로
# 실제 애플리케이션이 기대하는 PCAM_ 접두사 형식으로 작성해야 합니다.

# 시스템 상태 점검 주기
PCAM_CHECK_INTERVAL=10s

# CPU 사용률 경고 기준(%)
PCAM_CPU_THRESHOLD=90.0

# 메모리 사용률 경고 기준(%)
PCAM_MEMORY_THRESHOLD=90.0

# Azure OpenAI 설정
PCAM_AZURE_ENDPOINT=https://your-resource-name.openai.azure.com/
PCAM_AZURE_API_KEY=your-api-key-here
PCAM_AZURE_DEPLOYMENT=gpt-4o

# Ollama 설정 (llm_provider=ollama 일 때 사용)
PCAM_LLM_PROVIDER=ollama
PCAM_OLLAMA_ENDPOINT=http://localhost:11434
PCAM_OLLAMA_MODEL=gemma4:31b

# 알림용 봇 토큰
PCAM_BOT_TOKEN=your-bot-token-here

# 같은 이상 상태에 대해 다시 알림을 보내기까지의 최소 간격
PCAM_COOLDOWN_PERIOD=5m
